# Local defaults work without this file. Copy to .env when changing destinations.
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
DATA_DIR=./var
DATABASE_DRIVER=sqlite
# To move records online: DATABASE_DRIVER=postgres and set this URL.
DATABASE_URL=
MEDIA_DRIVER=local
# To move uploads online: MEDIA_DRIVER=s3 plus bucket credentials (S3/R2/MinIO).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Local demo only. Disable before any public deployment and create an admin.
DEMO_MODE=true
# Optional: choose a local demo-account password before the first start (12+ characters).
# With no value, demo authors have random credentials and cannot use a shared password.
DEMO_PASSWORD=
# Frontend may point to a separately hosted, compatible Makanlah API.
VITE_API_URL=
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
