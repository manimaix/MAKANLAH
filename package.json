{
  "name": "makanlah-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm --prefix backend run dev\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "npm --prefix backend start",
    "test": "npm --prefix backend test && node --test tests/*.test.mjs",
    "typecheck": "tsc -b",
    "backup": "npm --prefix backend run backup",
    "create-admin": "npm --prefix backend run create-admin",
    "migrate:online": "npm --prefix backend run migrate:online",
    "sample-video": "node scripts/sample-video.mjs",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:backend": "npm --prefix backend run dev",
    "setup": "npm ci && npm --prefix backend ci",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.8",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
